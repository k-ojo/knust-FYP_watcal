<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>M-Bus Data</title>
</head>
<body>
    <h1>M-Bus Data</h1>
    <a href="/">Back to Home</a>
    <table border="1">
        <tr>
            <th>Timestamp</th>
            <th>Value</th>
        </tr>
        <% data.forEach(function(entry) { %>
        <tr>
            <td><%= entry.timestamp %></td>
            <td><%= entry.value %></td>
        </tr>
        <% }); %>
    </table>
</body>
</html>
